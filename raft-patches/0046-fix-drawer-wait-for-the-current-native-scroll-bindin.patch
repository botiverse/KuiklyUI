             }
         }
 
+    internal suspend fun <R> withCurrentScrollViewBinding(
+        block: (ScrollerView<ScrollerAttr, ScrollerEvent>) -> R
+    ): R = scrollViewBinding.withCurrentBinding(block)
+
     /**
      * Scroll orientation
      */
