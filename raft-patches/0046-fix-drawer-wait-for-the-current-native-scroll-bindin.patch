@@ -54,11 +81,16 @@ class KuiklyScrollInfo {
     var scrollView: ScrollerView<ScrollerAttr, ScrollerEvent>? = null
         set(value) {
             field = value
+            scrollViewBinding.update(value)
             if (hasPullToRefresh && value != null) {
