+
+printf 'Kuikly producer staged: mode=%s source=%s tree=%s files=%s\n' \
+  "$MODE" "$SOURCE_SHA" "$SOURCE_TREE" "$(find "$REPOSITORY_DIR" -type f | wc -l | tr -d ' ')"
