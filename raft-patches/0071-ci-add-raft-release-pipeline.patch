+            )
+            for suffix, (algorithm, _) in contract.CHECKSUM_ALGORITHMS.items():
+                self.assertEqual(
+                    hashlib.new(algorithm, primary.read_bytes()).hexdigest() + "\n",
+                    primary.with_name(primary.name + suffix).read_text(encoding="ascii"),
+                )
