+cat > "$WORK_ROOT/gradle-project/settings.gradle.kts" <<'KOTLIN'
+pluginManagement {
+    repositories {
+        gradlePluginPortal()
+        google()
+        mavenCentral()
+    }
+}
+rootProject.name = "task93-pom-consumer"
+KOTLIN
+
