@@ -0,0 +1,619 @@
+name: Task93 Kuikly Immutable Release Set
+
+on:
+  pull_request:
+    branches: [staging4]
+    paths:
+      - "KUIKLY_RELEASE_SET"
+      - ".github/raft-artifacts/**"
+      - ".github/workflows/task93-kuikly-release.yml"
+      - "scripts/kuikly_*.py"
+      - "scripts/stage-kuikly-release.sh"
+      - "scripts/verify-kuikly-pom-consumer.sh"
+      - "gradle/raft-artifacts-publishing.gradle.kts"
+      - "build.2.1.21.gradle.kts"
+      - "settings.2.0.ohos.gradle.kts"
+      - "**/build.2.1.21.gradle.kts"
+      - "**/build.2.0.ohos.gradle.kts"
+      - "core-render-ios/**"
+      - "core-render-ohos/**"
+      - "iosApp/**"
+      - "ohosApp/**"
+      - "Gemfile.lock"
+  push:
+    branches: [staging4]
+    paths:
+      - "KUIKLY_RELEASE_SET"
+      - ".github/raft-artifacts/**"
+      - ".github/workflows/task93-kuikly-release.yml"
+      - "scripts/kuikly_*.py"
+      - "scripts/stage-kuikly-release.sh"
+      - "scripts/verify-kuikly-pom-consumer.sh"
+      - "gradle/raft-artifacts-publishing.gradle.kts"
+      - "build.2.1.21.gradle.kts"
+      - "settings.2.0.ohos.gradle.kts"
+      - "**/build.2.1.21.gradle.kts"
+      - "**/build.2.0.ohos.gradle.kts"
+      - "core-render-ios/**"
+      - "core-render-ohos/**"
+      - "iosApp/**"
+      - "ohosApp/**"
+      - "Gemfile.lock"
+  workflow_dispatch:
+    inputs:
+      source_sha:
+        description: Full reviewed and landed staging4 source SHA
+        required: true
+        type: string
+      source_tree:
+        description: Full source tree expected by the immutable release
+        required: false
+        type: string
+      tag_ref:
+        description: Fully qualified immutable tag ref (required to publish)
+        required: false
+        type: string
+      set_sha256:
+        description: Expected product-set SHA-256
+        required: false
+        type: string
+      predecessor_receipt_sha256:
+        description: Expected protected predecessor-receipt SHA-256
+        required: false
+        type: string
+      candidate_run_id:
+        description: Terminal publish=false run whose exact producer shards the writer must reuse
+        required: false
+        type: string
+      control_plane_sha:
+        description: Landed staging4 SHA supplying the publisher classifier and its contract
+        required: false
+        type: string
+      publish:
+        description: Enter the protected create-only publication job
+        required: true
+        default: false
+        type: boolean
+
+permissions:
+  contents: read
+  actions: read
+
+defaults:
+  run:
+    shell: bash
+
+concurrency:
+  group: task93-kuikly-${{ github.event_name == 'workflow_dispatch' && inputs.source_sha || github.event.pull_request.head.sha || github.sha }}
+  cancel-in-progress: false
+
+env:
+  SOURCE_SHA: ${{ github.event_name == 'workflow_dispatch' && inputs.source_sha || github.event.pull_request.head.sha || github.sha }}
+  DIFF_BASE_SHA: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || github.event_name == 'push' && github.event.before || '' }}
+  PUBLICATION_SOURCE_SHA: ${{ github.event_name == 'workflow_dispatch' && inputs.source_sha || github.event.pull_request.head.sha || github.sha }}
+  PUBLICATION_TAG_REF: ${{ github.event_name == 'workflow_dispatch' && inputs.tag_ref || '' }}
+  RAFT_REQUIRE_PUBLIC_PREDECESSORS: ${{ github.event_name == 'workflow_dispatch' && inputs.publish && 'true' || 'false' }}
+
+jobs:
+  contract:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    container:
+      image: python:3.8.20-slim-bookworm
+    steps:
+      - name: Install contract prerequisites
+        run: |
+          set -euo pipefail
+          apt-get update
+          apt-get install --yes --no-install-recommends git
+          rm -rf /var/lib/apt/lists/*
+          git config --global --add safe.directory "$GITHUB_WORKSPACE"
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.SOURCE_SHA }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Verify exact source and source-only contracts
+        env:
+          EXPECTED_TREE: ${{ github.event_name == 'workflow_dispatch' && inputs.source_tree || '' }}
+        run: |
+          set -euo pipefail
+          test "$(python3 --version)" = "Python 3.8.20"
+          [[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]]
+          test "$(git rev-parse HEAD)" = "$SOURCE_SHA"
+          test -z "$(git status --porcelain --untracked-files=all)"
+          if [[ -n "$EXPECTED_TREE" ]]; then
+            [[ "$EXPECTED_TREE" =~ ^[0-9a-f]{40}$ ]]
+            test "$(git rev-parse 'HEAD^{tree}')" = "$EXPECTED_TREE"
+          fi
+          python3 - <<'PY'
+          from pathlib import Path
+          for name in (
+              "scripts/kuikly_release_contract.py",
+              "scripts/kuikly_maven_publish.py",
+              "scripts/test_kuikly_release_contract.py",
+          ):
+              compile(Path(name).read_text(encoding="utf-8"), name, "exec")
+          PY
+          PYTHONDONTWRITEBYTECODE=1 python3 scripts/test_kuikly_release_contract.py
+          bash -n scripts/stage-kuikly-release.sh
+          bash -n scripts/verify-kuikly-pom-consumer.sh
+          test -x scripts/stage-kuikly-release.sh
+          test -x scripts/verify-kuikly-pom-consumer.sh
+          git check-ignore -q .bundle/config
+          git check-ignore -q vendor/bundle/task93-bootstrap
+          python3 - <<'PY'
+          from pathlib import Path
+          release = Path("KUIKLY_RELEASE_SET").read_text(encoding="utf-8").strip()
+          expected = f"{release}-2.0.21-ohos"
+          text = Path("core-render-ohos/oh-package.json5").read_text(encoding="utf-8")
+          if f'"version": "{expected}"' not in text:
+              raise SystemExit(f"oh-package.json5 version must be {expected}")
+          PY
+          diff_base="$DIFF_BASE_SHA"
+          if [[ -z "$diff_base" ]]; then
+            diff_base="$(git rev-parse "$SOURCE_SHA^")"
+          fi
+          [[ "$diff_base" =~ ^[0-9a-f]{40}$ ]]
+          git cat-file -e "${diff_base}^{commit}"
+          git diff --check "$diff_base" "$SOURCE_SHA"
+          test -z "$(git status --porcelain --untracked-files=all)"
+
+  normal-linux:
+    if: ${{ !(github.event_name == 'workflow_dispatch' && inputs.publish == true) }}
+    needs: contract
+    runs-on: ubuntu-latest
+    timeout-minutes: 90
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.SOURCE_SHA }}
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+      - uses: gradle/actions/setup-gradle@v4
+      - name: Stage normal Linux publications
+        run: scripts/stage-kuikly-release.sh normal-linux "$RUNNER_TEMP/kuikly-normal-linux"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: task93-normal-linux-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-normal-linux
+          if-no-files-found: error
+          retention-days: 14
+
+  normal-macos:
+    if: ${{ !(github.event_name == 'workflow_dispatch' && inputs.publish == true) }}
+    needs: contract
+    runs-on: macos-14
+    timeout-minutes: 120
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.SOURCE_SHA }}
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+      - uses: gradle/actions/setup-gradle@v4
+      - name: Select Xcode 16.2
+        run: sudo xcode-select -s /Applications/Xcode_16.2.app/Contents/Developer
+      - name: Stage Apple Kotlin publications
+        run: scripts/stage-kuikly-release.sh normal-macos "$RUNNER_TEMP/kuikly-normal-macos"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: task93-normal-macos-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-normal-macos
+          if-no-files-found: error
+          retention-days: 14
+
+  ios-renderer:
+    if: ${{ !(github.event_name == 'workflow_dispatch' && inputs.publish == true) }}
+    needs: contract
+    runs-on: macos-14
+    timeout-minutes: 120
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.SOURCE_SHA }}
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+      - uses: ruby/setup-ruby@v1
+        with:
+          ruby-version: "3.3"
+          bundler-cache: true
+      - uses: gradle/actions/setup-gradle@v4
+      - name: Select Xcode 16.2
+        run: sudo xcode-select -s /Applications/Xcode_16.2.app/Contents/Developer
+      - name: Stage deterministic iOS renderer
+        run: scripts/stage-kuikly-release.sh ios-renderer "$RUNNER_TEMP/kuikly-ios-renderer"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: task93-ios-renderer-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-ios-renderer
+          if-no-files-found: error
+          retention-days: 14
+
+  ohos-gradle:
+    if: ${{ !(github.event_name == 'workflow_dispatch' && inputs.publish == true) }}
+    needs: contract
+    runs-on: ubuntu-latest
+    timeout-minutes: 120
+    container:
+      image: ghcr.io/bytemain/harmony-next-pipeline-docker/harmonyos-ci-image:v6.1.1.280-android.1
+    env:
+      OHOS_SDK_HOME: /opt/harmonyos-tools/command-line-tools/sdk/default/openharmony
+      DEVECO_SDK_HOME: /opt/harmonyos-tools/command-line-tools/sdk
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.SOURCE_SHA }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Trust exact checkout
+        run: git config --global --add safe.directory "$GITHUB_WORKSPACE"
+      - name: Stage OHOS Kotlin publications
+        run: scripts/stage-kuikly-release.sh ohos-gradle "$RUNNER_TEMP/kuikly-ohos-gradle"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: task93-ohos-gradle-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-ohos-gradle
+          if-no-files-found: error
+          retention-days: 14
+
+  ohos-renderer:
+    if: ${{ !(github.event_name == 'workflow_dispatch' && inputs.publish == true) }}
+    needs: contract
+    runs-on: ubuntu-latest
+    timeout-minutes: 120
+    container:
+      image: ghcr.io/bytemain/harmony-next-pipeline-docker/harmonyos-ci-image:v6.1.1.280-android.1
+    env:
+      OHOS_SDK_HOME: /opt/harmonyos-tools/command-line-tools/sdk/default/openharmony
+      DEVECO_SDK_HOME: /opt/harmonyos-tools/command-line-tools/sdk
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.SOURCE_SHA }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Trust exact checkout
+        run: git config --global --add safe.directory "$GITHUB_WORKSPACE"
+      - name: Stage deterministic OHOS renderer
+        run: scripts/stage-kuikly-release.sh ohos-renderer "$RUNNER_TEMP/kuikly-ohos-renderer"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: task93-ohos-renderer-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-ohos-renderer
+          if-no-files-found: error
+          retention-days: 14
+
+  assemble-candidate:
+    if: ${{ !(github.event_name == 'workflow_dispatch' && inputs.publish == true) }}
+    needs: [normal-linux, normal-macos, ios-renderer, ohos-gradle, ohos-renderer]
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.SOURCE_SHA }}
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+      - name: Install exact Maven consumer
+        run: |
+          set -euo pipefail
+          sudo apt-get update
+          sudo apt-get install --yes --no-install-recommends maven=3.8.7-2
+          /usr/bin/mvn --version | grep -F "Apache Maven 3.8.7"
+      - uses: gradle/actions/setup-gradle@v4
+      - uses: actions/download-artifact@v4
+        with:
+          name: task93-normal-linux-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-stages/normal-linux
+      - uses: actions/download-artifact@v4
+        with:
+          name: task93-normal-macos-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-stages/normal-macos
+      - uses: actions/download-artifact@v4
+        with:
+          name: task93-ios-renderer-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-stages/ios-renderer
+      - uses: actions/download-artifact@v4
+        with:
+          name: task93-ohos-gradle-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-stages/ohos-gradle
+      - uses: actions/download-artifact@v4
+        with:
+          name: task93-ohos-renderer-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-stages/ohos-renderer
+      - name: Assemble and preflight the source-review candidate
+        run: |
+          set -euo pipefail
+          stages="$RUNNER_TEMP/kuikly-stages"
+          candidate="$RUNNER_TEMP/kuikly-candidate"
+          mkdir -p "$candidate"
+          python3 scripts/kuikly_release_contract.py merge-toolchains \
+            --receipt "$stages/normal-linux/toolchain.json" \
+            --receipt "$stages/normal-macos/toolchain.json" \
+            --receipt "$stages/ios-renderer/toolchain.json" \
+            --receipt "$stages/ohos-gradle/toolchain.json" \
+            --receipt "$stages/ohos-renderer/toolchain.json" \
+            --output "$candidate/toolchains.json"
+          assemble_args=(--allow-unreleased)
+          if [[ -n "$PUBLICATION_TAG_REF" ]]; then
+            assemble_args=(--tag-ref "$PUBLICATION_TAG_REF")
+          fi
+          python3 scripts/kuikly_release_contract.py assemble \
+            --source-root "$GITHUB_WORKSPACE" \
+            --staging "normal-linux=$stages/normal-linux/repository" \
+            --staging "normal-macos=$stages/normal-macos/repository" \
+            --staging "ios-renderer=$stages/ios-renderer/repository" \
+            --staging "ohos-gradle=$stages/ohos-gradle/repository" \
+            --staging "ohos-renderer=$stages/ohos-renderer/repository" \
+            "${assemble_args[@]}" \
+            --predecessor-receipts .github/raft-artifacts/kuikly-predecessors.candidate.json \
+            --toolchains "$candidate/toolchains.json" \
+            --output "$candidate/manifest.json" \
+            --bundle-output "$candidate/bundle"
+          python3 scripts/kuikly_release_contract.py validate --manifest "$candidate/manifest.json"
+          scripts/verify-kuikly-pom-consumer.sh \
+            "$candidate/bundle" \
+            "$RUNNER_TEMP/kuikly-candidate-consumer" \
+            "$candidate/pom-consumer.json"
+          python3 scripts/kuikly_maven_publish.py plan \
+            --manifest "$candidate/manifest.json" \
+            --bundle "$candidate/bundle" \
+            --output "$candidate/public-plan.json"
+          jq -e '.state == "ALL_ABSENT" or .state == "PARTIAL_EXACT" or .state == "ALL_COMPLETE_EXACT"' \
+            "$candidate/public-plan.json" >/dev/null
+          sha256sum \
+            "$candidate/manifest.json" "$candidate/toolchains.json" \
+            "$candidate/pom-consumer.json" \
+            "$candidate/pom-consumer-maven-raw.log" \
+            "$candidate/pom-consumer-gradle-owner.tsv" \
+            "$candidate/public-plan.json" \
+            > "$candidate/SHA256SUMS"
+      # Runs on failure too: the publication plan written by kuikly_maven_publish.py
+      # is the only artefact that says WHY a preflight failed. The step above prints
+      # a one-line summary (state + present/total) and writes the discriminating
+      # lists -- unexpected / different / listingDisagreement -- to public-plan.json.
+      # Without `always()` that file is discarded exactly when the job fails, leaving
+      # a CONFLICT with no way to tell a benign source-identity difference from a real
+      # byte divergence. `warn` rather than `error` because an early failure may abort
+      # before the candidate directory exists; a missing upload must not manufacture a
+      # second, misleading failure on top of the real one.
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: task93-candidate-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-candidate
+          if-no-files-found: warn
+          retention-days: 14
+
+  publish:
+    if: >-
+      ${{
+        always() &&
+        github.event_name == 'workflow_dispatch' &&
+        inputs.publish == true &&
+        needs.contract.result == 'success' &&
+        needs.assemble-candidate.result == 'skipped' &&
+        needs.normal-linux.result == 'skipped' &&
+        needs.normal-macos.result == 'skipped' &&
+        needs.ios-renderer.result == 'skipped' &&
+        needs.ohos-gradle.result == 'skipped' &&
+        needs.ohos-renderer.result == 'skipped'
+      }}
+    needs: [contract, assemble-candidate, normal-linux, normal-macos, ios-renderer, ohos-gradle, ohos-renderer]
+    runs-on: ubuntu-latest
+    timeout-minutes: 90
+    environment: raft-artifacts-production
+    env:
+      EXPECTED_SOURCE_TREE: ${{ inputs.source_tree }}
+      EXPECTED_SET_SHA256: ${{ inputs.set_sha256 }}
+      EXPECTED_PREDECESSOR_RECEIPT_SHA256: ${{ inputs.predecessor_receipt_sha256 }}
+      PINNED_CANDIDATE_RUN_ID: ${{ inputs.candidate_run_id }}
+      CONTROL_PLANE_SHA: ${{ inputs.control_plane_sha }}
+      RAFT_ARTIFACTS_PUBLISH_TOKEN: ${{ secrets.RAFT_ARTIFACTS_PUBLISH_TOKEN }}
+      PREDECESSOR_RECEIPTS_JSON: ${{ secrets.RAFT_KUIKLY_PREDECESSOR_RECEIPTS }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.SOURCE_SHA }}
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+      - name: Install exact Maven consumer
+        run: |
+          set -euo pipefail
+          sudo apt-get update
+          sudo apt-get install --yes --no-install-recommends maven=3.8.7-2
+          /usr/bin/mvn --version | grep -F "Apache Maven 3.8.7"
+      - uses: gradle/actions/setup-gradle@v4
+      - name: Verify the pinned candidate carrier
+        run: |
+          set -euo pipefail
+          [[ "$PINNED_CANDIDATE_RUN_ID" =~ ^[1-9][0-9]*$ ]]
+          test "$PINNED_CANDIDATE_RUN_ID" != "$GITHUB_RUN_ID"
+          [[ "$CONTROL_PLANE_SHA" =~ ^[0-9a-f]{40}$ ]]
+      - uses: actions/download-artifact@v4
+        with:
+          name: task93-normal-linux-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-stages/normal-linux
+          github-token: ${{ github.token }}
+          repository: ${{ github.repository }}
+          run-id: ${{ inputs.candidate_run_id }}
+      - uses: actions/download-artifact@v4
+        with:
+          name: task93-normal-macos-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-stages/normal-macos
+          github-token: ${{ github.token }}
+          repository: ${{ github.repository }}
+          run-id: ${{ inputs.candidate_run_id }}
+      - uses: actions/download-artifact@v4
+        with:
+          name: task93-ios-renderer-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-stages/ios-renderer
+          github-token: ${{ github.token }}
+          repository: ${{ github.repository }}
+          run-id: ${{ inputs.candidate_run_id }}
+      - uses: actions/download-artifact@v4
+        with:
+          name: task93-ohos-gradle-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-stages/ohos-gradle
+          github-token: ${{ github.token }}
+          repository: ${{ github.repository }}
+          run-id: ${{ inputs.candidate_run_id }}
+      - uses: actions/download-artifact@v4
+        with:
+          name: task93-ohos-renderer-${{ env.SOURCE_SHA }}
+          path: ${{ runner.temp }}/kuikly-stages/ohos-renderer
+          github-token: ${{ github.token }}
+          repository: ${{ github.repository }}
+          run-id: ${{ inputs.candidate_run_id }}
+      - name: Verify protected inputs and assemble publishable exact bytes
+        run: |
+          set -euo pipefail
+          [[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]]
+          [[ "$EXPECTED_SOURCE_TREE" =~ ^[0-9a-f]{40}$ ]]
+          for value in "$EXPECTED_SET_SHA256" "$EXPECTED_PREDECESSOR_RECEIPT_SHA256"; do
+            [[ "$value" =~ ^[0-9a-f]{64}$ ]]
+          done
+          [[ "$PUBLICATION_TAG_REF" == refs/tags/* ]]
+          test "$(git rev-parse HEAD)" = "$SOURCE_SHA"
+          test "$(git rev-parse 'HEAD^{tree}')" = "$EXPECTED_SOURCE_TREE"
+          test "$(git rev-parse "${PUBLICATION_TAG_REF}^{commit}")" = "$SOURCE_SHA"
+          if [[ "$GITHUB_REF" == refs/heads/release/* ]]; then
+            HOTFIX_PUBLISH=1
+          else
+            HOTFIX_PUBLISH=0
+            test "$GITHUB_REF" = "refs/heads/staging4"
+          fi
+          live_staging4="$(
+            git ls-remote --exit-code "https://github.com/${GITHUB_REPOSITORY}.git" refs/heads/staging4 \
+              | awk 'NR == 1 { print $1 }'
+          )"
+          [[ "$live_staging4" =~ ^[0-9a-f]{40}$ ]]
+          if ! git cat-file -e "${live_staging4}^{commit}" 2>/dev/null; then
+            git fetch --no-tags origin "$live_staging4"
+          fi
+          test "$live_staging4" = "$CONTROL_PLANE_SHA"
+          control_plane="$RUNNER_TEMP/kuikly-control-plane"
+          git worktree add --detach "$control_plane" "$CONTROL_PLANE_SHA"
+          test "$(git -C "$control_plane" rev-parse HEAD)" = "$CONTROL_PLANE_SHA"
+          PYTHONDONTWRITEBYTECODE=1 python3 "$control_plane/scripts/test_kuikly_release_contract.py" \
+            PublisherTests.test_checksum_listing_is_optional_but_exact_get_is_required
+          if test "$HOTFIX_PUBLISH" = "1"; then
+            PYTHONDONTWRITEBYTECODE=1 python3 scripts/kuikly_release_contract.py verify-hotfix-source \
+              --source-root "$GITHUB_WORKSPACE" \
+              --source-sha "$SOURCE_SHA" \
+              --staging4-sha "$live_staging4"
+          else
+            PYTHONDONTWRITEBYTECODE=1 python3 scripts/kuikly_release_contract.py verify-landed-source \
+              --source-root "$GITHUB_WORKSPACE" \
+              --source-sha "$SOURCE_SHA" \
+              --staging4-sha "$live_staging4"
+          fi
+          echo "post-verify workspace status (diagnostic):"
+          publish_status="$(git -c core.untrackedCache=false status --porcelain --untracked-files=all)"
+          printf '%s\n' "$publish_status"
+          test -z "$publish_status"
+
+          protected="$RUNNER_TEMP/kuikly-protected"
+          final="$RUNNER_TEMP/kuikly-final"
+          stages="$RUNNER_TEMP/kuikly-stages"
+          mkdir -p "$protected" "$final"
+          python3 - "$protected/predecessors.json" <<'PY'
+          import os
+          import pathlib
+          import sys
+          value = os.environ.get("PREDECESSOR_RECEIPTS_JSON", "")
+          if not value:
+              raise SystemExit("missing protected input: PREDECESSOR_RECEIPTS_JSON")
+          pathlib.Path(sys.argv[1]).write_bytes(value.encode("utf-8"))
+          PY
+          test "$(sha256sum "$protected/predecessors.json" | awk '{print $1}')" = "$EXPECTED_PREDECESSOR_RECEIPT_SHA256"
+
+          python3 scripts/kuikly_release_contract.py merge-toolchains \
+            --receipt "$stages/normal-linux/toolchain.json" \
+            --receipt "$stages/normal-macos/toolchain.json" \
+            --receipt "$stages/ios-renderer/toolchain.json" \
+            --receipt "$stages/ohos-gradle/toolchain.json" \
+            --receipt "$stages/ohos-renderer/toolchain.json" \
+            --output "$final/toolchains.json"
+          python3 scripts/kuikly_release_contract.py assemble \
+            --source-root "$GITHUB_WORKSPACE" \
+            --staging "normal-linux=$stages/normal-linux/repository" \
+            --staging "normal-macos=$stages/normal-macos/repository" \
+            --staging "ios-renderer=$stages/ios-renderer/repository" \
+            --staging "ohos-gradle=$stages/ohos-gradle/repository" \
+            --staging "ohos-renderer=$stages/ohos-renderer/repository" \
+            --tag-ref "$PUBLICATION_TAG_REF" \
+            --predecessor-receipts "$protected/predecessors.json" \
+            --toolchains "$final/toolchains.json" \
+            --require-publishable \
+            --output "$final/manifest.json" \
+            --bundle-output "$final/bundle"
+          test "$(jq -r .setSha256 "$final/manifest.json")" = "$EXPECTED_SET_SHA256"
+          scripts/verify-kuikly-pom-consumer.sh \
+            "$final/bundle" \
+            "$RUNNER_TEMP/kuikly-final-consumer" \
+            "$final/pom-consumer.json"
+          PYTHONDONTWRITEBYTECODE=1 python3 "$control_plane/scripts/kuikly_maven_publish.py" plan \
+            --manifest "$final/manifest.json" --bundle "$final/bundle" \
+            --output "$final/public-plan.json"
+          jq -e '((.state == "ALL_ABSENT" and .presentCount == 0) or (.state == "PARTIAL_EXACT" and .presentCount > 0)) and .presentCount < 920 and .productFileCount == 920 and
+            (.unexpected | length) == 0 and (.different | length) == 0 and
+            (.listingDisagreement | length) == 0 and .completionPresent == false' \
+            "$final/public-plan.json" >/dev/null
+          echo "post-plan workspace status (diagnostic):"
+          publish_status="$(git -c core.untrackedCache=false status --porcelain --untracked-files=all)"
+          printf '%s\n' "$publish_status"
+          test -z "$publish_status"
+      - name: Publish or resume immutable release and verify public bytes
+        run: |
+          set -euo pipefail
+          PYTHONDONTWRITEBYTECODE=1 python3 "$RUNNER_TEMP/kuikly-control-plane/scripts/kuikly_maven_publish.py" release \
+            --manifest "$RUNNER_TEMP/kuikly-final/manifest.json" \
+            --plan "$RUNNER_TEMP/kuikly-final/public-plan.json" \
+            --bundle "$RUNNER_TEMP/kuikly-final/bundle" \
+            --output "$RUNNER_TEMP/kuikly-final/execution-receipt.json"
+          jq -e '.state == "complete" and .publicReadbackCount > 1' "$RUNNER_TEMP/kuikly-final/execution-receipt.json" >/dev/null
+          sha256sum \
+            "$RUNNER_TEMP/kuikly-final/manifest.json" \
+            "$RUNNER_TEMP/kuikly-final/pom-consumer.json" \
+            "$RUNNER_TEMP/kuikly-final/pom-consumer-maven-raw.log" \
+            "$RUNNER_TEMP/kuikly-final/pom-consumer-gradle-owner.tsv" \
+            "$RUNNER_TEMP/kuikly-final/public-plan.json" \
+            "$RUNNER_TEMP/kuikly-final/execution-receipt.json" \
+            > "$RUNNER_TEMP/kuikly-final/SHA256SUMS"
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: task93-release-receipt-${{ env.SOURCE_SHA }}
+          path: |
+            ${{ runner.temp }}/kuikly-final/manifest.json
+            ${{ runner.temp }}/kuikly-final/toolchains.json
+            ${{ runner.temp }}/kuikly-final/pom-consumer.json
+            ${{ runner.temp }}/kuikly-final/pom-consumer-maven-raw.log
+            ${{ runner.temp }}/kuikly-final/pom-consumer-gradle-owner.tsv
+            ${{ runner.temp }}/kuikly-final/public-plan.json
+            ${{ runner.temp }}/kuikly-final/execution-receipt.json
+            ${{ runner.temp }}/kuikly-final/SHA256SUMS
+          if-no-files-found: warn
+          retention-days: 30
