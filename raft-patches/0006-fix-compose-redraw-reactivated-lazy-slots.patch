                     precomposed
                 } else {
                     takeNodeFromReusables(slotId)
@@ -1122,6 +1123,7 @@ internal class LayoutNodeSubcompositionsState(
             nodeState.activeState = mutableStateOf(true)
             nodeState.forceReuse = true
