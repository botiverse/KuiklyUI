diff --git a/core-render-ohos/src/main/cpp/libohos_render/expand/components/input/KRTextFieldView.h b/core-render-ohos/src/main/cpp/libohos_render/expand/components/input/KRTextFieldView.h
index e9196c71ccbd939525980b8c6dee1e160325d1de..5f7d50102c58abc657304eb7bb4d393b6c76135a 100644
--- a/core-render-ohos/src/main/cpp/libohos_render/expand/components/input/KRTextFieldView.h
