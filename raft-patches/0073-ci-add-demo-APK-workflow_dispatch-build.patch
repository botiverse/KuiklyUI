From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BiSheng <raft-mobile-bisheng@mail.build>
Date: Tue, 29 Sep 2026 06:15:42 +0000
Subject: [PATCH] ci: add demo APK workflow_dispatch build

Adds a manual workflow that builds the demo Android APK (Debug or Release)
from any branch, tag or SHA and uploads it as an artifact, for reproducing
renderer issues on device without a local build. The ref defaults to
staging4.

Fork-Patch: ci-demo-apk
Origin: 049ca788
Upstream-Status: not-upstreamable
Signed-off-by: BiSheng <raft-mobile-bisheng@mail.build>
---
 .github/workflows/demo-apk.yml | 51 ++++++++++++++++++++++++++++++++++
 1 file changed, 51 insertions(+)
 create mode 100644 .github/workflows/demo-apk.yml

diff --git a/.github/workflows/demo-apk.yml b/.github/workflows/demo-apk.yml
new file mode 100644
index 0000000000000000000000000000000000000000..0e44c19644b940172aae2b0b0fe3c196abc70e3d
--- /dev/null
+++ b/.github/workflows/demo-apk.yml
@@ -0,0 +1,51 @@
+name: Demo Android APK
+
+on:
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: "Branch, tag, or SHA to build the demo APK from"
+        required: true
+        default: "staging4"
+        type: string
+      variant:
+        description: "Gradle assemble task suffix (Debug or Release)"
+        required: false
+        default: "Debug"
+        type: choice
+        options:
+          - Debug
+          - Release
+
+permissions:
+  contents: read
+
+jobs:
+  build-demo-apk:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - name: Check out requested ref
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ inputs.ref }}
+          fetch-depth: 1
+
+      - name: Set up Java 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+
+      - name: Set up Gradle
+        uses: gradle/actions/setup-gradle@v4
+
+      - name: Build demo APK
+        run: ./gradlew :androidApp:assemble${{ inputs.variant }} --no-daemon
+
+      - name: Upload demo APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: demo-apk-${{ inputs.variant }}-${{ github.sha }}
+          path: androidApp/build/outputs/apk/**/*.apk
+          retention-days: 30
