+
+        nowNanos += KuiklyScrollInfo.IGNORE_SCROLL_OFFSET_TIMEOUT_NANOS
+        assertEquals(KuiklyScrollInfo.NativeScrollEventDisposition.SyncOnly, info.resolve(6_000f))
+        assertNull(info.ignoreScrollOffset)
+    }
