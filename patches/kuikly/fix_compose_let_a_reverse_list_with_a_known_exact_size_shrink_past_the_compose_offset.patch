--- a/compose/src/commonTest/kotlin/com/tencent/kuikly/compose/gestures/ReverseScrollOffsetMappingTest.kt
+++ b/compose/src/commonTest/kotlin/com/tencent/kuikly/compose/gestures/ReverseScrollOffsetMappingTest.kt
@@ -199,6 +199,20 @@ class ReverseScrollOffsetMappingTest {
         )
     }
 
+    // botiverse/mobile task #37 (second device round): a fast fling towards the oldest message
+    // of a short reverse thread held contentH at the 3000dp placeholder for the whole gesture,
+    // because a shrink below the Compose offset grew the content back. With the exact size
+    // known, a reverse list shrinks so the re-anchor clamps native to the real end.
+    @Test
+    fun reverseListWithExactSizeShrinksPastTheComposeOffset() {
+        assertFalse(mapping.keepContentSizeForComposeOffset(reverseLayout = true, exactContentSizeKnown = true))
+        // Estimate still open (end not reached): keep the existing behaviour.
+        assertTrue(mapping.keepContentSizeForComposeOffset(reverseLayout = true, exactContentSizeKnown = false))
+        // Normal lists keep the existing behaviour regardless.
+        assertTrue(mapping.keepContentSizeForComposeOffset(reverseLayout = false, exactContentSizeKnown = true))
+        assertTrue(mapping.keepContentSizeForComposeOffset(reverseLayout = false, exactContentSizeKnown = false))
+    }
+
     @Test
     fun reanchorNeverDefersWithoutAFrameChangeOrWhenForced() {
         // No content size change: nothing to defer, the call is already free.
