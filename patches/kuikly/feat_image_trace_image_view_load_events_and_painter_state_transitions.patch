 #include "libohos_render/api/src/KRAnyDataInternal.h"
@@ -224,10 +225,32 @@ bool KRImageView::ResetProp(const std::string &prop_key) {
     return didHanded;
 }
 
+// Short, url-free id so one image load can be followed across the adapter
+// callback, the ArkUI complete/error events and the Kotlin painter without
+// writing signed urls to hilog.
+static std::string KRImageTraceId(const std::string &src) {
+    std::ostringstream oss;
+    oss << std::hex << (std::hash<std::string>{}(src) & 0xffffffffu);
+    return oss.str();
+}
+
 void KRImageView::OnEvent(ArkUI_NodeEvent *event, const ArkUI_NodeEventType &event_type) {
     if (event_type == NODE_IMAGE_ON_COMPLETE) {
+        int32_t status = -1;
+        if (auto component_event = OH_ArkUI_NodeEvent_GetNodeComponentEvent(event)) {
+            status = component_event->data[0].i32;
+        }
+        auto size = kuikly::util::GetArkUINodeImagePicSize(event);
+        KR_LOG_INFO << "image load complete id=" << KRImageTraceId(image_src_) << " status=" << status
+                    << " pic=" << size.width << "x" << size.height
+                    << " successCb=" << (load_success_callback_ ? 1 : 0)
+                    << " resolutionCb=" << (load_resolution_callback_ ? 1 : 0);
         FireOnImageCompleteEvent(event);
     } else if (event_type == NODE_IMAGE_ON_ERROR) {
+        KR_LOG_ERROR << "image load error id=" << KRImageTraceId(image_src_)
+                     << " code=" << kuikly::util::GetImageLoadSuccessStatusCode(event)
+                     << " srcKind=" << (isFile(image_src_) ? "file" : (isNetwork(image_src_) ? "network" : "other"))
+                     << " failureCb=" << (load_failure_callback_ ? 1 : 0);
         FireOnImageErrorEvent(event);
     }
 }
