From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BiSheng <raft-mobile-bisheng@mail.build>
Date: Tue, 29 Sep 2026 06:05:03 +0000
Subject: fix(compose): preserve draw dispatch semantics

DrawModifierNode's view-aware draw(view) called drawContent() directly, so
nodes that override only ContentDrawScope.draw() (drawWithContent,
LazyLayoutItemAnimator, ...) were skipped. Route draw(view) through draw(),
whose default now draws the content, matching upstream Compose semantics.

Fork-Patch: compose-preserve-draw-dispatch-semantics
Origin: 155d8737
Upstream-Status: pending
Signed-off-by: BiSheng <raft-mobile-bisheng@mail.build>

diff --git a/compose/src/commonMain/kotlin/com/tencent/kuikly/compose/ui/node/DrawModifierNode.kt b/compose/src/commonMain/kotlin/com/tencent/kuikly/compose/ui/node/DrawModifierNode.kt
index de814536bcdd195057570c26eab243ac35a41954..6286cab3e0d57aa3106f8c5aa2d6ebe111dd6e13 100644
--- a/compose/src/commonMain/kotlin/com/tencent/kuikly/compose/ui/node/DrawModifierNode.kt
+++ b/compose/src/commonMain/kotlin/com/tencent/kuikly/compose/ui/node/DrawModifierNode.kt
@@ -32,10 +32,12 @@ import com.tencent.kuikly.core.base.DeclarativeBaseView
  * @sample com.tencent.kuikly.compose.ui.samples.DrawModifierNodeSample
  */
 interface DrawModifierNode : DelegatableNode {
-    fun ContentDrawScope.draw() { }
+    fun ContentDrawScope.draw() {
+        drawContent()
+    }
     fun onMeasureResultChanged() {}
     fun ContentDrawScope.draw(view: DeclarativeBaseView<*, *>?) {
-        drawContent()
+        draw()
     }
 }
 
