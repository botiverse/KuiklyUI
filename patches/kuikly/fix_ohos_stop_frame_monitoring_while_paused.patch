diff --git a/core-render-ohos/src/test/cpp/frame_monitor_stubs/native_vsync/native_vsync.h b/core-render-ohos/src/test/cpp/frame_monitor_stubs/native_vsync/native_vsync.h
new file mode 100644
index 0000000000000000000000000000000000000000..0eb895e7f5c420d2bea8910dc1401f1baa021068
--- /dev/null
+++ b/core-render-ohos/src/test/cpp/frame_monitor_stubs/native_vsync/native_vsync.h
@@ -0,0 +1,15 @@
+#ifndef KUIKLY_TEST_NATIVE_VSYNC_H
+#define KUIKLY_TEST_NATIVE_VSYNC_H
+
+// Host substitute for the NativeVSync API used by KRFrameMonitor.
+// Signatures match native_vsync.h; the fixture controls callback delivery.
+extern "C" {
+struct OH_NativeVSync;
+typedef void (*OH_NativeVSync_FrameCallback)(long long timestamp, void *data);
+OH_NativeVSync *OH_NativeVSync_Create(const char *name, unsigned int length);
+void OH_NativeVSync_Destroy(OH_NativeVSync *nativeVsync);
+int OH_NativeVSync_RequestFrame(OH_NativeVSync *nativeVsync,
+                               OH_NativeVSync_FrameCallback callback, void *data);
+}
+
+#endif
diff --git a/core-render-ohos/src/test/cpp/run_frame_monitor_lifecycle_test.sh b/core-render-ohos/src/test/cpp/run_frame_monitor_lifecycle_test.sh
new file mode 100755
index 0000000000000000000000000000000000000000..02236929ce9d6b6027eb460de48f2ef49a4f8e4e
--- /dev/null
+++ b/core-render-ohos/src/test/cpp/run_frame_monitor_lifecycle_test.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+# CI host fixture: exercise production lifecycle/callback code with NativeVSync
+# delivery and platform logging replaced. No device, renderer build or SDK needed.
+set -euo pipefail
+
+script_dir="$(cd "$(dirname "$0")" && pwd)"
+cpp_root="$(cd "$script_dir/../../main/cpp" && pwd)"
+build_dir="$(mktemp -d)"
+trap 'rm -rf "$build_dir"' EXIT
+
+"${CC:-cc}" -std=c99 -c "$cpp_root/thirdparty/cJSON/cJSON.c" -o "$build_dir/cJSON.o"
+
+# Existing production units contain unused local/parameter warnings. Keep the
+# fixture itself strict, without expanding this lifecycle fix into cleanup.
+# The SDK logging include normally supplies strlen; the stub has no SDK headers.
+for unit in performance/KRMonitor performance/frame/KRFrameData performance/frame/KRFrameMonitor; do
+  "${CXX:-c++}" -std=c++17 -Wall -Wextra -Werror \
+    -Wno-unused-variable -Wno-unused-parameter -include cstring -include cstdint \
+    -I"$script_dir/frame_monitor_stubs" -I"$cpp_root" \
+    -c "$cpp_root/libohos_render/$unit.cpp" -o "$build_dir/$(basename "$unit").o"
+done
+
+"${CXX:-c++}" -std=c++17 -Wall -Wextra -Werror \
+  -include cstdint \
+  -I"$script_dir/frame_monitor_stubs" -I"$cpp_root" \
+  "$script_dir/frame_monitor_lifecycle_test.cpp" \
+  "$build_dir/KRFrameMonitor.o" "$build_dir/KRFrameData.o" \
+  "$build_dir/KRMonitor.o" "$build_dir/cJSON.o" \
+  -lm -o "$build_dir/frame_monitor_lifecycle_test"
+
+"$build_dir/frame_monitor_lifecycle_test"
