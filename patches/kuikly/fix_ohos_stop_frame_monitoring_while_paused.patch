diff --git a/core-render-ohos/src/test/cpp/frame_monitor_lifecycle_test.cpp b/core-render-ohos/src/test/cpp/frame_monitor_lifecycle_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..74d0b765fba61dd3db6333d467cab2f9fd09654f
--- /dev/null
+++ b/core-render-ohos/src/test/cpp/frame_monitor_lifecycle_test.cpp
@@ -0,0 +1,149 @@
+#include "libohos_render/performance/frame/KRFrameMonitor.h"
+#include "thirdparty/cJSON/cJSON.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+struct OH_NativeVSync {
+    OH_NativeVSync_FrameCallback callback = nullptr;
+    void *data = nullptr;
+};
+
+namespace {
+OH_NativeVSync *active_vsync = nullptr;
+int request_count = 0;
+int destroy_count = 0;
+bool fail_create = false;
+
+void Expect(bool condition, const char *message) {
+    if (!condition) {
+        std::fprintf(stderr, "FAIL: %s\n", message);
+        std::exit(1);
+    }
+}
+
+void DeliverFrame(long long timestamp) {
+    Expect(active_vsync && active_vsync->callback, "a requested callback must be pending");
+    const auto callback = active_vsync->callback;
+    void *data = active_vsync->data;
+    // RequestFrame is single-shot and replaces an earlier request in the same
+    // frame. Clear before delivery so production code can request its next tick.
+    active_vsync->callback = nullptr;
+    active_vsync->data = nullptr;
+    callback(timestamp, data);
+}
+
+long long Metric(KRFrameMonitor &monitor, const char *name) {
+    cJSON *json = cJSON_Parse(monitor.GetMonitorData().c_str());
+    Expect(json != nullptr, "production monitor data must be JSON");
+    cJSON *value = cJSON_GetObjectItemCaseSensitive(json, name);
+    Expect(cJSON_IsNumber(value), name);
+    const auto result = static_cast<long long>(value->valuedouble);
+    cJSON_Delete(json);
+    return result;
+}
+}  // namespace
+
+extern "C" OH_NativeVSync *OH_NativeVSync_Create(const char *name, unsigned int length) {
+    Expect(active_vsync == nullptr, "only one monitor is alive per scenario");
+    Expect(std::strlen(name) == length, "monitor supplies a valid VSync name");
+    if (!fail_create) {
+        active_vsync = new OH_NativeVSync;
+    }
+    return active_vsync;
+}
+
+extern "C" void OH_NativeVSync_Destroy(OH_NativeVSync *vsync) {
+    Expect(vsync && vsync == active_vsync, "destroy the owned VSync exactly once");
+    ++destroy_count;
+    delete vsync;
+    active_vsync = nullptr;
+}
+
+extern "C" int OH_NativeVSync_RequestFrame(OH_NativeVSync *vsync,
+                                           OH_NativeVSync_FrameCallback callback, void *data) {
+    Expect(vsync && vsync == active_vsync && callback, "request uses a live VSync and callback");
+    ++request_count;
+    vsync->callback = callback;
+    vsync->data = data;
+    return 0;
+}
+
+int main() {
+    {
+        KRFrameMonitor monitor;
+        monitor.OnPause();
+        monitor.OnResume();
+        Expect(request_count == 0, "pause/resume before first paint must not request frames");
+
+        monitor.OnFirstFramePaint();
+        monitor.OnFirstFramePaint();
+        monitor.OnResume();
+        Expect(request_count == 1, "first paint starts once; duplicate start/resume does not request");
+        DeliverFrame(1000000000LL);
+        Expect(Metric(monitor, "totalDuration") == 0, "first callback establishes the timing baseline");
+        Expect(Metric(monitor, "frameCount") == 0, "baseline callback is not a completed frame interval");
+        Expect(Metric(monitor, "hitchesDuration") == 0, "baseline callback records no hitch");
+        DeliverFrame(1016000000LL);
+        Expect(Metric(monitor, "totalDuration") == 16, "active callbacks accumulate elapsed time");
+        Expect(Metric(monitor, "frameCount") == 1, "frameCount reports intervals, not elapsed milliseconds");
+        Expect(Metric(monitor, "hitchesDuration") == 0, "a 16ms interval does not report a hitch");
+        const auto data_before_pause = monitor.GetMonitorData();
+        const int requests_before_pause = request_count;
+
+        monitor.OnPause();
+        monitor.OnPause();
+        DeliverFrame(7000000000LL);  // callback already queued before pause
+        Expect(request_count == requests_before_pause, "paused callback must not rearm NativeVSync");
+        Expect(active_vsync->callback == nullptr, "paused monitor drains the pending callback");
+        Expect(monitor.GetMonitorData() == data_before_pause, "paused callback must not change statistics");
+
+        monitor.OnResume();
+        monitor.OnResume();
+        Expect(request_count == requests_before_pause + 1, "resume must request exactly one fresh frame");
+        DeliverFrame(10000000000LL);
+        Expect(monitor.GetMonitorData() == data_before_pause, "resume baseline excludes the background gap");
+        DeliverFrame(10016000000LL);
+        Expect(Metric(monitor, "totalDuration") == 32, "measurement continues with foreground time after resume");
+        Expect(Metric(monitor, "frameCount") == 2, "resume baseline does not add a frame interval");
+        Expect(Metric(monitor, "hitchesDuration") == 0, "background gap does not add hitch time");
+
+        DeliverFrame(10056000000LL);  // 40ms foreground interval; 23ms beyond the 60Hz budget
+        Expect(Metric(monitor, "totalDuration") == 72, "slow frame contributes its full elapsed time");
+        Expect(Metric(monitor, "frameCount") == 3, "slow frame contributes one interval, not its duration");
+        Expect(Metric(monitor, "hitchesDuration") == 23, "hitchesDuration reports only the excess frame time");
+
+        // A second transition verifies that pause is not a one-time stop.
+        const int requests_before_second_pause = request_count;
+        monitor.OnPause();
+        DeliverFrame(20000000000LL);
+        Expect(request_count == requests_before_second_pause, "second pause also stops rearming");
+        monitor.OnResume();
+        Expect(request_count == requests_before_second_pause + 1, "second resume rearms once");
+
+        const auto data_before_destroy = monitor.GetMonitorData();
+        const int requests_before_destroy = request_count;
+        monitor.OnDestroy();
+        monitor.OnDestroy();
+        monitor.OnResume();
+        DeliverFrame(30000000000LL);  // object still alive; no callback after C++ destruction
+        Expect(request_count == requests_before_destroy, "destroyed lifecycle must not request frames");
+        Expect(monitor.GetMonitorData() == data_before_destroy, "stopped callback must not change statistics");
+    }
+    Expect(destroy_count == 1 && active_vsync == nullptr, "destructor releases NativeVSync once");
+
+    // Keep the platform-create-failure path safe across the same lifecycle.
+    fail_create = true;
+    const int requests_before_failure = request_count;
+    {
+        KRFrameMonitor monitor;
+        monitor.OnFirstFramePaint();
+        monitor.OnPause();
+        monitor.OnResume();
+        monitor.OnDestroy();
+    }
+    Expect(request_count == requests_before_failure && destroy_count == 1,
+           "a missing NativeVSync must not be requested or destroyed");
+    std::puts("PASS: production KRFrameMonitor pause/resume lifecycle");
+}
