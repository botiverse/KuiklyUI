+    }
 }
 
+/**
+ * Sum of the cached main-axis size (with spacing) of every item, plus [leadingPadding], or null
+ * if any item is not in [cache] or the list is longer than [maxItems] (kept O(n) cheap).
+ */
+internal fun measuredItemsContentSize(
+    itemsCount: Int,
+    keyAt: (Int) -> Any,
+    cache: Map<Any, Int>,
+    leadingPadding: Int,
+    maxItems: Int = MEASURED_CONTENT_SIZE_MAX_ITEMS,
+): Int? {
+    if (itemsCount <= 0 || itemsCount > maxItems || cache.size < itemsCount) return null
+    var sum = leadingPadding
+    for (index in 0 until itemsCount) {
+        sum += cache[keyAt(index)] ?: return null
+    }
+    return sum
+}
+
+private const val MEASURED_CONTENT_SIZE_MAX_ITEMS = 500
