+package com.tencent.kuikly.compose.scroller
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+
+/**
+ * botiverse/mobile task #37: during a fast native fling Compose lagged behind and never saw the
+ * last item, so the exact content size stayed unknown and the native list ran past the real
+ * end into the placeholder. Once every item has been measured the size is known anyway.
+ */
+class MeasuredItemsContentSizeTest {
+
+    private val keys = listOf("a", "b", "c")
+
+    @Test
+    fun sumsEveryMeasuredItemPlusLeadingPadding() {
+        val cache = mapOf<Any, Int>("a" to 100, "b" to 250, "c" to 60)
+        assertEquals(410 + 12, measuredItemsContentSize(3, keys::get, cache, leadingPadding = 12))
+    }
+
+    @Test
+    fun unknownWhileAnyItemIsUnmeasured() {
+        val cache = mapOf<Any, Int>("a" to 100, "c" to 60, "stale" to 999)
+        assertNull(measuredItemsContentSize(3, keys::get, cache, leadingPadding = 0))
+    }
+
+    @Test
+    fun staleCacheEntriesDoNotCount() {
+        // Enough entries in total, but one current item is missing: still unknown.
+        val cache = mapOf<Any, Int>("a" to 1, "b" to 2, "old1" to 3, "old2" to 4)
+        assertNull(measuredItemsContentSize(3, keys::get, cache, leadingPadding = 0))
+    }
+
+    @Test
+    fun emptyOrTooLongListsAreLeftToTheEstimate() {
+        assertNull(measuredItemsContentSize(0, keys::get, emptyMap(), leadingPadding = 0))
+        val cache = mapOf<Any, Int>("a" to 1, "b" to 2, "c" to 3)
+        assertNull(measuredItemsContentSize(3, keys::get, cache, leadingPadding = 0, maxItems = 2))
+    }
+}
