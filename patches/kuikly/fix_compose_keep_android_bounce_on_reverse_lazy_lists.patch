+++ b/compose/src/commonMain/kotlin/com/tencent/kuikly/compose/gestures/ReverseScrollOffsetMapping.kt
@@ -61,13 +61,23 @@ internal object ReverseScrollOffsetMapping {
         if (reverseLayout) -logicalDelta else logicalDelta
 
     /**
-     * Native offset the scroll handlers map. Only reverse lists without native bounce (Android)
-     * clamp: an Android over-scroll translates the content view past the range, which a reverse
-     * mapping would read as a jump at the list start.
+     * Native offset the scroll handlers map. Reverse lists on Android clamp: an Android over-scroll
+     * (bounce) translates the content view past the range, which a reverse mapping would otherwise
+     * read as a jump at the list start. The bounce itself stays visible natively.
      */
     fun boundedNativeOffset(nativeOffset: Int, maxNativeOffset: Int, clamp: Boolean): Int =
         if (clamp) nativeOffset.coerceIn(0, maxNativeOffset) else nativeOffset
 
+    /**
+     * Whether a reported offset outside the native range must be re-synced into it at once.
+     * Not while an Android reverse list bounces: the over-scroll translation is reported as an
+     * out-of-range offset during the drag and the bounce-back, the clamped value already keeps the
+     * logical offset still, and native returns to the range by itself. Re-syncing would cancel the
+     * bounce. Every other case keeps the immediate re-sync.
+     */
+    fun resyncOutOfRangeNativeOffset(reverseLayout: Boolean, isAndroid: Boolean, nativeBounceEnabled: Boolean): Boolean =
+        !(reverseLayout && isAndroid && nativeBounceEnabled)
+
     /** A programmatic move of a reverse list: logical result and the native move that realises it. */
     data class Move(val logicalOffset: Int, val nativeOffset: Int, val nativeDelta: Int)
 
