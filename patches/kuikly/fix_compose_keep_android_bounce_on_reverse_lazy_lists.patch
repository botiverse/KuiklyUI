+     * the range by itself. Re-syncing it would cancel the bounce mid-gesture.
+     */
+    internal fun shouldResyncOutOfRangeNativeOffset(): Boolean =
+        ReverseScrollOffsetMapping.resyncOutOfRangeNativeOffset(
+            reverseLayout = reverseLayout,
+            isAndroid = pageData?.isAndroid == true,
+            nativeBounceEnabled = nativeBounceEnabled()
+        )
+
+    private fun nativeBounceEnabled(): Boolean =
+        (scrollView?.extProps?.get(KuiklyUserBouncesEnableKey) as? Boolean) ?: true
+
+    /**
+     * Native offset the scroll handlers map. Reverse lists on Android clamp it to the range so an
+     * over-scroll (bounce) never moves the logical offset.
+     */
     internal fun boundedNativeScrollOffset(nativeOffset: Int): Int =
         ReverseScrollOffsetMapping.boundedNativeOffset(
             nativeOffset,
