+
+    @Test
+    fun androidReverseListLetsItsBounceSettleInsteadOfResyncing() {
+        // An Android reverse list with bounce on reports the over-scroll as an out-of-range offset;
+        // re-syncing it would cancel the bounce mid-drag.
+        assertFalse(mapping.resyncOutOfRangeNativeOffset(reverseLayout = true, isAndroid = true, nativeBounceEnabled = true))
+        // Bounce off (or the app disabled it): an out-of-range report is a real desync, re-sync it.
+        assertTrue(mapping.resyncOutOfRangeNativeOffset(reverseLayout = true, isAndroid = true, nativeBounceEnabled = false))
