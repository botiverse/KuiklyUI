-            resetHRBackground()
+            resetDecorationForReuse()
             return true
         }
         KRCssConst.BORDER -> {
-            resetBorder()
+            resetDecorationForReuse()
             return true
         }
         KRCssConst.CLICK -> {
@@ -578,16 +578,13 @@ private var View.borderStyle: String?
 /**
  * 重置View的background
  */
-private fun View.resetHRBackground() {
+private fun View.resetDecorationForReuse() {
+    optViewDecorator()?.resetForReuse()
     background = null
-    destroyViewDecorator()
-}
