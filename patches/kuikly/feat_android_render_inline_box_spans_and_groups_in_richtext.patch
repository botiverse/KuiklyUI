+private fun SpannableStringBuilder.applyInlineBoxAtomicTextSpan(
+    start: Int,
+    end: Int,
+    style: KRInlineBoxSpanStyle,
+) {
+    if (start < end) {
+        setSpan(
+            KRInlineBoxAtomicTextSpan(style),
+            start,
+            end,
+            Spannable.SPAN_EXCLUSIVE_EXCLUSIVE
+        )
+    }
+}
