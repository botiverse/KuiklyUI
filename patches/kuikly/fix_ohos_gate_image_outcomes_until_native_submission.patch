+        if (kind == 4) { src = "assets://A"; f.view->root.reset(); }
+        if (kind == 5 || kind == 6) {
+            src = "resource:A";
+            boundary::convert = [](auto option) { option->src_type_ = KRImageSrcType::kImageSrcTypeResourceMedia; };
+            if (kind == 5) f.view->root.reset(); // no root
