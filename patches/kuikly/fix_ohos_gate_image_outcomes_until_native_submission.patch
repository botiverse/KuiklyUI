+#!/usr/bin/env python3
+"""Host fixture for actual KRImageView source; no OHOS SDK is needed.
+
+The class declaration and tested methods are copied verbatim from production
+into a temporary translation unit. The C++ fixture replaces external adapter,
+view registry, ArkUI and cache/resource boundaries, not the load-state logic.
+`--generate-only DIR` performs extraction without compiling/running anything.
+Normal invocation compiles/runs the bounded fixture in CI, using CXX or c++.
+This is not an ArkUI integration, image decoder or device rendering test.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import tempfile
+
+METHODS = (
+    "SetProp", "ResetProp", "OnEvent", "OnDestroy",
+    "AdapterSetImageCallback", "BeginImageSourceChange",
+    "SubmitImageDescriptor", "SubmitNativeImageSource", "SetImageSrc",
+    "EnsureLoadCompleteEventRegistered", "RegisterLoadSuccessCallback",
+    "RegisterLoadResolutionCallback", "RegisterLoadFailureCallback",
+    "FireOnImageErrorEvent", "FireAdapterImageErrorEvent",
+    "FireOnImageCompleteEvent", "ToImageLoadOption", "LoadFromSrc",
+    "LoadFromNetwork", "LoadFromFile", "LoadFromBase64", "LoadFromResourceMedia", "LoadFromAssets",
+)
+FREE_FUNCTIONS = ("isBase64", "isNetwork", "isFile", "isAssets")
+
+
+def mask_literals_and_comments(text: str) -> str:
+    # Keep offsets/newlines identical, so extraction retains original bytes.
+    pattern = r'//[^\n]*|/\*[\s\S]*?\*/|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\''
+    return re.sub(pattern, lambda m: re.sub(r"[^\n]", " ", m.group()), text)
+
+
+def extract(text: str, pattern: str, label: str) -> tuple[str, int]:
+    clean = mask_literals_and_comments(text)
+    matches = list(re.finditer(pattern, clean, re.M))
+    if len(matches) != 1:
+        raise ValueError(f"expected one {label}, found {len(matches)}")
+    start = matches[0].start()
+    brace = clean.find("{", matches[0].end())
+    if brace < 0:
+        raise ValueError(f"missing body for {label}")
+    depth = 0
+    for end in range(brace, len(clean)):
+        if clean[end] == "{":
+            depth += 1
+        elif clean[end] == "}":
+            depth -= 1
+            if not depth:
+                return text[start : end + 1], text.count("\n", 0, start) + 1
+    raise ValueError(f"unterminated body for {label}")
+
+
+def generate(root: Path, out: Path) -> None:
+    source_dir = root / "core-render-ohos/src/main/cpp/libohos_render/expand/components/image"
+    cpp, header = source_dir / "KRImageView.cpp", source_dir / "KRImageView.h"
+    source, declaration = cpp.read_text(), header.read_text()
+    out.mkdir(parents=True, exist_ok=True)
+    class_body, class_line = extract(declaration, r"^class KRImageView\s*:", "KRImageView declaration")
+    (out / "production-image-class.inc").write_text(
+        f"#line {class_line} {json.dumps(str(header))}\n{class_body};\n"
+    )
+    sections = ["// Exact production constants and method bodies; generated, do not edit.\n"]
+    sections += [line for line in source.splitlines(keepends=True) if re.match(r"^constexpr\b.*;\s*$", line)]
+    receipt = []
+    for name in (*FREE_FUNCTIONS, *METHODS):
+        scope = "" if name in FREE_FUNCTIONS else "KRImageView::"
+        body, line = extract(source, rf"^(?:bool|void|uint64_t|std::shared_ptr<[^>]+>)\s+{scope}{name}\s*\(", name)
+        sections.append(f"\n#line {line} {json.dumps(str(cpp))}\n{body}\n")
+        receipt.append({"method": scope + name, "line": line, "sha256": hashlib.sha256(body.encode()).hexdigest()})
+    (out / "production-image-methods.inc").write_text("".join(sections))
+    (out / "extraction-receipt.json").write_text(json.dumps({
+        "cpp_sha256": hashlib.sha256(cpp.read_bytes()).hexdigest(),
+        "header_sha256": hashlib.sha256(header.read_bytes()).hexdigest(),
+        "methods": receipt,
+        "boundary": "Actual production class/methods/source loaders; host stubs for ArkUI, registry, adapters and cache/resource boundaries; no device proof.",
+    }, indent=2) + "\n")
+    print(f"Extracted {len(receipt)} production functions into {out}")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--generate-only", type=Path)
+    args = parser.parse_args()
+    if args.generate_only:
+        generate(args.source_root.resolve(), args.generate_only.resolve())
+        return
+    with tempfile.TemporaryDirectory(prefix="kuikly-image-outcomes-") as temp:
+        out = Path(temp)
+        generate(args.source_root.resolve(), out)
+        compiler = shlex.split(os.environ.get("CXX", "c++"))
+        fixture = Path(__file__).with_name("image-pending-outcomes-fixture.cpp")
+        binary = out / "image-pending-outcomes-fixture"
+        subprocess.run(compiler + ["-std=c++17", "-Wall", "-Wextra", "-I", str(out), str(fixture), "-o", str(binary)],
+                       check=True, timeout=120)
+        subprocess.run([str(binary)], check=True, timeout=30)
+
+
+if __name__ == "__main__":
+    main()
