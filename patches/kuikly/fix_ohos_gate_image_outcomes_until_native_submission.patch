+static void reset_and_conversion_reentry_keep_new_source() {
+    {
+        Fixture f; f.async(); bool nested = false;
+        boundary::reset = [&](auto) { if (!nested) { nested = true; f.source("https://B"); } };
+        f.source("https://A");
