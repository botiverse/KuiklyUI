+int main() {
+    try {
+        premature_outcomes_are_suppressed();
+        synchronous_descriptor_outcomes_are_accepted();
+        explicit_failure_bypasses_native_gate();
+        native_fallback_paths_remain_active();
+        decline_and_reset_reuse();
+        success_reentry_does_not_finish_old_request();
+        reset_and_conversion_reentry_keep_new_source();
+        adapter_failure_reentry_and_capinsets_reentry();
+        native_completion_reentry_does_not_apply_old_tint();
+        legacy_v1_descriptor_and_reentry_preserve_deallocation();
+        same_source_does_not_reopen_gate();
+        unsubmitted_sources_cannot_accept_queued_outcomes();
+        resource_submission_opens_gate_only_for_drawable();
