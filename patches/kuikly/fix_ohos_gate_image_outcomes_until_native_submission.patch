+static void snapshot_hit_miss_and_reentry() {
+    for (bool hit : {false, true}) {
+        Fixture f;
+        boundary::snapshot = [hit](auto n, const auto&) {
+            if (hit) event(n, NODE_IMAGE_ON_COMPLETE);
+            return hit;
+        };
+        f.source("data:image_Md5_Pixelmap,A");
+        CHECK(f.view->native_image_events_enabled_ == hit);
+        CHECK(f.successes.size() == (hit ? 1u : 0u));
+        if (!hit) { event(*f.view, NODE_IMAGE_ON_ERROR, 401); CHECK(f.failures.empty()); }
+    }
+    Fixture f;
+    boundary::snapshot = [](auto n, const auto&) { event(n, NODE_IMAGE_ON_COMPLETE); return true; };
+    f.view->RegisterLoadSuccessCallback([&](KRAnyValue) { f.async(); f.source("https://B"); });
+    f.source("data:image_Md5_Pixelmap,A");
+    CHECK(f.view->image_src_ == "https://B" && !f.view->native_image_events_enabled_);
+    CHECK(!f.view->has_loaded_image_ && f.resolutions == 0);
