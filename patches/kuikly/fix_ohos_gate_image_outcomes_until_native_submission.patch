+bool KRImageView::ResetColorFilter() { return true; }
+void KRImageView::ResetMaskLinearGradientNode() {}
+void KRImageView::ApplyCapInsetsWithLattice() { if (boundary::capInsets) boundary::capInsets(GetNode()); }
+#include "production-image-methods.inc"
+
+#define CHECK(condition) do { if (!(condition)) throw std::runtime_error( \
+    std::string(__func__) + ": " + #condition); } while (0)
+static void event(KRImageView& view, int type, int code = 0) {
+    ArkUI_NodeEvent e{code, {128, 64}};
+    view.OnEvent(&e, type);
+}
+static void event(ArkUI_NodeHandle n, int type, int code = 0) {
+    event(*static_cast<KRImageView*>(n), type, code);
+}
+struct Request {
+    const void* context;
+    std::string source;
+    AdapterCallback callback;
+    void deliver(ArkUI_DrawableDescriptor* descriptor = nullptr, const char* fallback = nullptr) const {
+        callback(context, source.c_str(), descriptor, fallback);
+    }
+};
+struct Fixture {
+    std::shared_ptr<KRImageView> view = std::make_shared<KRImageView>();
+    std::vector<Request> requests;
+    std::vector<std::string> successes, failures;
+    std::vector<int> codes;
+    int resolutions = 0;
+    ArkUI_DrawableDescriptor descriptor;
+    Fixture() {
+        *KRImageAdapterManager::GetInstance() = {};
+        boundary::reset = {}; boundary::submit = {}; boundary::native = {};
+        boundary::capInsets = {}; boundary::convert = {};
+        boundary::snapshot = {}; boundary::resourceDrawable = nullptr;
+        boundary::descriptorCalls = boundary::nativeCalls = boundary::tintCalls = boundary::deallocations = 0;
+        KRRenderManager::GetInstance().render->view = view;
+        view->SetProp("loadSuccess", nullptr, [this](KRAnyValue p) { successes.push_back(p->map.at("src")->text); });
+        view->SetProp("loadFailure", nullptr, [this](KRAnyValue p) {
+            failures.push_back(p->map.at("src")->text);
+            codes.push_back(static_cast<int>(p->map.at("errorCode")->number));
+        });
+        view->SetProp("loadResolution", nullptr, [this](KRAnyValue) { ++resolutions; });
+    }
+    void async(int version = 3) {
+        auto capture = [this](const void* c, const char* s, AdapterCallback cb) {
+            requests.push_back({c, s, cb}); return 1;
+        };
+        if (version == 2) KRImageAdapterManager::GetInstance()->v2 = capture;
+        else KRImageAdapterManager::GetInstance()->v3 = [capture](const void* c, const char* s, KRAnyData, AdapterCallback cb) {
+            return capture(c, s, cb);
+        };
+    }
+    void source(const char* src) { CHECK(view->SetProp("src", NewKRRenderValue(src))); }
+};
+
+static void premature_outcomes_are_suppressed() {
+    for (int version : {2, 3}) {
+        Fixture f; f.async(version);
+        boundary::reset = [](auto n) { event(n, NODE_IMAGE_ON_ERROR, 401); event(n, NODE_IMAGE_ON_COMPLETE); };
+        f.source("https://A");
+        event(*f.view, NODE_IMAGE_ON_ERROR, 103101);
+        event(*f.view, NODE_IMAGE_ON_COMPLETE);
+        CHECK(f.failures.empty() && f.successes.empty() && f.resolutions == 0);
+        CHECK(!f.view->has_loaded_image_ && !f.view->has_original_image_size_);
+        int replay = 0;
+        f.view->RegisterLoadSuccessCallback([&](KRAnyValue) { ++replay; });
+        CHECK(replay == 0);
+        boundary::submit = [](auto n) { event(n, NODE_IMAGE_ON_COMPLETE); };
+        f.requests.at(0).deliver(&f.descriptor);
+        CHECK(replay == 1 && f.resolutions == 1 && f.view->has_loaded_image_);
+        CHECK(f.view->loaded_image_size_.width == 128);
+        event(*f.view, NODE_IMAGE_ON_COMPLETE, 1);
+        CHECK(replay == 1 && f.resolutions == 1);
+    }
+}
+static void synchronous_descriptor_outcomes_are_accepted() {
+    for (int version : {2, 3}) for (int kind : {NODE_IMAGE_ON_ERROR, NODE_IMAGE_ON_COMPLETE}) {
+        Fixture f;
+        boundary::submit = [kind](auto n) { event(n, kind, kind == NODE_IMAGE_ON_ERROR ? 401 : 0); };
+        auto sync = [&](const void* c, const char* s, AdapterCallback cb) { cb(c, s, &f.descriptor, nullptr); return 1; };
+        if (version == 2) KRImageAdapterManager::GetInstance()->v2 = sync;
+        else KRImageAdapterManager::GetInstance()->v3 = [&](const void* c, const char* s, KRAnyData, AdapterCallback cb) { return sync(c, s, cb); };
+        f.source("https://A");
+        CHECK(f.view->native_image_events_enabled_ && boundary::descriptorCalls == 1);
+        CHECK(kind == NODE_IMAGE_ON_ERROR ? f.codes == std::vector<int>{401} : f.successes == std::vector<std::string>{"https://A"});
+    }
+}
+static void explicit_failure_bypasses_native_gate() {
+    for (const char* fallback : {static_cast<const char*>(nullptr), ""}) {
+        Fixture f; f.async(); f.source("https://A");
+        f.requests.at(0).deliver(nullptr, fallback);
+        CHECK(f.codes == std::vector<int>{-1});
+        CHECK(!f.view->native_image_events_enabled_);
+        event(*f.view, NODE_IMAGE_ON_ERROR, 401);
+        CHECK(f.codes.size() == 1);
+    }
+}
+static void native_fallback_paths_remain_active() {
+    for (const char* source : {"https://A", "file://A", "data:image/png,A", "assets://A"}) {
+        Fixture f;
+        boundary::native = [](auto n) { event(n, NODE_IMAGE_ON_ERROR, 401); event(n, NODE_IMAGE_ON_COMPLETE); };
+        f.source(source);
+        CHECK(boundary::nativeCalls == 1 && f.codes == std::vector<int>{401});
+        CHECK(f.successes == std::vector<std::string>{source} && f.resolutions == 1);
+    }
+    Fixture f; f.async(); f.source("https://A");
+    boundary::convert = [](auto option) { option->src_ = "file://converted"; option->src_type_ = KRImageSrcType::kImageSrcTypeFile; };
+    boundary::native = [](auto n) { event(n, NODE_IMAGE_ON_COMPLETE); };
+    f.requests.at(0).deliver(nullptr, "https://rewritten");
+    CHECK(f.successes == std::vector<std::string>{"file://converted"});
+    CHECK(f.view->image_src_ == "file://converted");
+}
+static void decline_and_reset_reuse() {
+    Fixture f;
+    KRImageAdapterManager::GetInstance()->v3 = [](const void*, const char*, KRAnyData, AdapterCallback) { return 0; };
+    boundary::native = [](auto n) { event(n, NODE_IMAGE_ON_COMPLETE); };
+    f.source("https://A"); CHECK(f.successes.size() == 1);
+    f.view->ResetProp("src");
+    CHECK(!f.view->native_image_events_enabled_ && !f.view->has_loaded_image_);
+    f.async(); f.source("https://B");
+    f.view->ResetProp("src");
+    event(*f.view, NODE_IMAGE_ON_COMPLETE);
+    f.requests.at(0).deliver(&f.descriptor);
+    CHECK(boundary::descriptorCalls == 0 && !f.view->has_loaded_image_);
+    f.source("https://C");
+    boundary::submit = [](auto n) { event(n, NODE_IMAGE_ON_COMPLETE); };
+    f.requests.at(1).deliver(&f.descriptor);
+    CHECK(f.successes.back() == "https://C");
+    f.view->OnDestroy(); event(*f.view, NODE_IMAGE_ON_ERROR, 401);
+    CHECK(f.failures.empty() && !f.view->native_image_events_enabled_);
+}
+static void success_reentry_does_not_finish_old_request() {
+    Fixture f; f.async(); f.source("https://A");
+    f.view->RegisterLoadSuccessCallback([&](KRAnyValue p) {
+        f.successes.push_back(p->map.at("src")->text); f.source("https://B");
