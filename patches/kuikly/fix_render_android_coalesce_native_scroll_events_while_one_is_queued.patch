+package com.tencent.kuikly.core.render.android.scheduler
+
+/**
+ * Latest-value coalescing for high-frequency view events delivered to the context queue.
+ *
+ * The first [offer] for a key asks the caller to post one drain task; later offers before that
+ * task runs only replace the value. The drain task keeps the queue position of the first event,
+ * so events posted after it (scroll end, drag end) still run after it, and it delivers the
+ * newest value together with how many offers it stands for.
+ */
+internal class LatestEventCoalescer<K> {
+
+    class Drained(val value: Any?, val count: Int)
+
+    private class Slot(var value: Any?, var count: Int)
+
+    private val slots = HashMap<K, Slot>()
+
+    /** Records [value] for [key]; returns true when the caller must post a drain task. */
+    fun offer(key: K, value: Any?): Boolean = synchronized(slots) {
+        val slot = slots[key]
+        if (slot != null) {
+            slot.value = value
+            slot.count += 1
+            false
+        } else {
+            slots[key] = Slot(value, 1)
+            true
+        }
+    }
+
+    /** Removes and returns the pending value for [key], or null if nothing is pending. */
+    fun drain(key: K): Drained? = synchronized(slots) {
+        slots.remove(key)?.let { Drained(it.value, it.count) }
+    }
+}
