From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BiSheng <raft-mobile-bisheng@mail.build>
Date: Tue, 29 Sep 2026 06:22:16 +0000
Subject: fix(ios): disable autocapitalization and autocorrection for
 credential inputs

For keyboardType email/password, turn off autocapitalization,
autocorrection and spell checking on KRTextFieldView (Compose single-line
and password TextFields render through it). The UIKit-only traits are
guarded with !TARGET_OS_OSX so the macOS shim still compiles.

Fork-Patch: ios-input-credential-traits
Origin: 9ba11795 (KRTextFieldView.m part)
Upstream-Status: pending
Signed-off-by: BiSheng <raft-mobile-bisheng@mail.build>

diff --git a/core-render-ios/Extension/Components/KRTextFieldView.m b/core-render-ios/Extension/Components/KRTextFieldView.m
index 145365e493cae80431ffed6b140f0d56e60cd2e4..da6c4497c3847a4e356e4f55fcb9c300a3dcc66e 100644
--- a/core-render-ios/Extension/Components/KRTextFieldView.m
+++ b/core-render-ios/Extension/Components/KRTextFieldView.m
@@ -248,7 +248,18 @@ NSString *const KRVFontWeightKey = @"fontWeight";
 
 - (void)setCss_keyboardType:(NSString *)css_keyboardType {
     self.keyboardType = [KRConvertUtil hr_keyBoardType:css_keyboardType];
-    [self setSecureTextEntry:[css_keyboardType isEqualToString:@"password"]];
+    BOOL isPassword = [css_keyboardType isEqualToString:@"password"];
+    BOOL isEmail = [css_keyboardType isEqualToString:@"email"];
+    [self setSecureTextEntry:isPassword];
+#if !TARGET_OS_OSX
+    if (isEmail || isPassword) {
+        self.autocapitalizationType = UITextAutocapitalizationTypeNone;
+        self.autocorrectionType = UITextAutocorrectionTypeNo;
+        self.spellCheckingType = UITextSpellCheckingTypeNo;
+    }
+#else
+    (void)isEmail;
+#endif
 }
 
 - (void)setCss_returnKeyType:(NSString *)css_returnKeyType {
