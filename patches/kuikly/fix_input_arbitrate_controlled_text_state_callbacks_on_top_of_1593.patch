+    fun nativeIdentityProvenanceWindowIsBounded() {
+        val arbiter = TextInputControlledStateArbiter()
+        val nativeValues = (0..64).map { index ->
+            val text = "draft-$index"
+            value(text = text, selection = text.length)
+        }
