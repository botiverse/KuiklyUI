+// Short, url-free correlation id for the fetch pipeline logs below. Signed
+// urls must not be logged; the id lets one request be followed from
+// CacheImage through the ArkTS fetch callback to the pixelmap result.
+static std::string KRCacheTraceId(const std::string &src) {
+    std::ostringstream oss;
+    oss << std::hex << (std::hash<std::string>{}(src) & 0xffffffffu);
+    return oss.str();
+}
