     // Sync external refresh state
-    LaunchedEffect(state.isRefreshing) {
-        if (state.isRefreshing) {
+    LaunchedEffect(state.isRefreshing, holdRefreshInset) {
+        if (state.isRefreshing && holdRefreshInset) {
