+namespace {
+// Diagnostic candidate only. No URL, account, node pointer or view reference enters the ring.
+constexpr uint32_t kImageProbeCapacity = 256;
+constexpr unsigned int kImageProbeDomain = 0xA068;
+enum ImageProbePhase : uint8_t {
+    ProbeIdle, ProbeResetSource, ProbeResetReturned, ProbePendingAdapter,
+    ProbeDescriptorCall, ProbeDescriptorReturned, ProbeNativeSource,
+    ProbeResetProperty, ProbeResetPropertyReturned
+};
+enum ImageProbeEvent : uint8_t {
+    ProbeError, ProbeComplete, ProbeDescriptor, ProbeRejectSource,
+    ProbeMissingView, ProbeMissingInstance, ProbeAdapterError
+};
+
+uint64_t ImageProbeHash(std::string_view value) {
+    // Matches Mobile's image-adapter hash for correlation; it is not a privacy/security boundary.
+    uint64_t hash = 1469598103934665603ULL;
+    for (unsigned char character : value) {
+        hash ^= character;
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+bool ImageProbeIsHttp(std::string_view value) {
+    return value.rfind(kHttpPrefix, 0) == 0 || value.rfind(kHttpsPrefix, 0) == 0;
+}
+
+struct ImageProbeRecord {
+    int64_t mono_us = 0;
+    int64_t epoch_ms = 0;
+    uint64_t instance_hash = 0;
+    uint64_t generation = 0;
+    uint64_t operation_generation = 0;
+    uint64_t src_hash = 0;
+    uint64_t current_src_hash = 0;
+    uint64_t callback_src_hash = 0;
+    int32_t tag = 0;
+    int32_t code = 0;
+    int32_t reset_rc = -1;
+    int32_t set_rc = -1;
+    float width = 0;
+    float height = 0;
+    uint8_t event = ProbeError;
+    uint8_t phase = ProbeIdle;
+    uint8_t callbacks = 0;
+    bool descriptor_received = false;
+    bool set_returned = false;
+    bool node_present = false;
+};
+struct ImageProbeSlot {
+    ImageProbeRecord record;
+    std::atomic<bool> ready{false};
+};
+struct ImageProbeBuffer {
+    std::array<ImageProbeSlot, kImageProbeCapacity> slots;
+    std::atomic<uint32_t> reserved{0};
+    std::atomic<uint64_t> dropped{0};
+    std::atomic<bool> closed{false};
+    std::thread worker;
+};
+
+void DrainImageProbe(ImageProbeBuffer *buffer) {
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(120);
+    const char *events[] = {"error", "complete", "descriptor", "reject_source",
+                            "missing_view", "missing_instance", "adapter_error"};
+    const char *phases[] = {"idle", "reset_source", "reset_returned", "pending_adapter",
+                            "descriptor_call", "descriptor_returned", "native_source",
+                            "reset_property", "reset_property_returned"};
+    OH_LOG_Print(LOG_APP, LOG_INFO, kImageProbeDomain, "ArkImageProbe",
+                 "probe_started capacity=256 intervalMs=100 durationSeconds=120");
+    uint32_t next = 0;
+    while (next < kImageProbeCapacity && std::chrono::steady_clock::now() < deadline) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        auto &slot = buffer->slots[next];
+        if (!slot.ready.load(std::memory_order_acquire)) continue;
+        const auto &r = slot.record;
+        // Formatting/HiLog occur only on this worker, at most one record per 100ms.
+        OH_LOG_Print(LOG_APP, LOG_INFO, kImageProbeDomain, "ArkImageProbe",
+                     "seq=%{public}u event=%{public}s monoUs=%{public}lld epochMs=%{public}lld "
+                     "instanceHash=%{public}016llx tag=%{public}d generation=%{public}llu "
+                     "operationGeneration=%{public}llu "
+                     "srcHash=%{public}016llx currentSrcHash=%{public}016llx callbackSrcHash=%{public}016llx "
+                     "phaseAtDelivery=%{public}s descriptorReceived=%{public}d setReturned=%{public}d "
+                     "nodePresent=%{public}d resetRc=%{public}d setRc=%{public}d code=%{public}d "
+                     "width=%{public}.1f height=%{public}.1f callbacks=%{public}u dropped=%{public}llu",
+                     next + 1, events[r.event], static_cast<long long>(r.mono_us),
+                     static_cast<long long>(r.epoch_ms), static_cast<unsigned long long>(r.instance_hash), r.tag,
+                     static_cast<unsigned long long>(r.generation),
+                     static_cast<unsigned long long>(r.operation_generation), static_cast<unsigned long long>(r.src_hash),
+                     static_cast<unsigned long long>(r.current_src_hash),
+                     static_cast<unsigned long long>(r.callback_src_hash), phases[r.phase],
+                     static_cast<int>(r.descriptor_received), static_cast<int>(r.set_returned),
+                     static_cast<int>(r.node_present), r.reset_rc, r.set_rc, r.code,
+                     static_cast<double>(r.width), static_cast<double>(r.height), static_cast<unsigned int>(r.callbacks),
+                     static_cast<unsigned long long>(buffer->dropped.load(std::memory_order_relaxed)));
+        ++next;
+    }
+    buffer->closed.store(true, std::memory_order_release);
+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    const uint32_t reserved = buffer->reserved.load(std::memory_order_relaxed);
+    OH_LOG_Print(LOG_APP, LOG_INFO, kImageProbeDomain, "ArkImageProbe",
+                 "probe_closed closed=1 capacity=256 emitted=%{public}u reserved=%{public}u "
+                 "pendingAtClose=%{public}u budgetExhausted=%{public}d "
+                 "droppedAtClose=%{public}llu laterEventsNotRecorded=1",
+                 next, reserved, reserved - next, reserved >= kImageProbeCapacity ? 1 : 0,
+                 static_cast<unsigned long long>(buffer->dropped.load(std::memory_order_relaxed)));
+}
+
+void RecordImageProbe(ImageProbeRecord record) {
+    record.mono_us = std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    record.epoch_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    // Intentionally process-lifetime: the worker/ring never observe static destruction.
+    // Allocation/thread failure disables diagnostics without changing image delivery.
+    static ImageProbeBuffer *buffer = []() -> ImageProbeBuffer * {
+        auto *created = new (std::nothrow) ImageProbeBuffer;
+        if (!created) return nullptr;
+        try {
+            created->worker = std::thread(DrainImageProbe, created);
+        } catch (...) {
+            delete created;
+            return nullptr;
+        }
+        return created;
+    }();
+    if (!buffer) return;
+    if (buffer->closed.load(std::memory_order_acquire)) {
+        buffer->dropped.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    uint32_t index = buffer->reserved.load(std::memory_order_relaxed);
+    do {
+        if (index >= kImageProbeCapacity) {
+            buffer->dropped.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+    } while (!buffer->reserved.compare_exchange_weak(index, index + 1, std::memory_order_relaxed));
+    buffer->slots[index].record = record;
+    buffer->slots[index].ready.store(true, std::memory_order_release);
+}
+} // namespace
+
+void KRImageView::BeginImageProbeSource(const std::string &src, bool reset_property) {
+    ++image_probe_generation_;
+    image_probe_http_ = ImageProbeIsHttp(src) || ImageProbeIsHttp(image_src_);
+    image_probe_src_hash_ = image_probe_http_ ? ImageProbeHash(src) : 0;
+    image_probe_phase_ = reset_property ? ProbeResetProperty : ProbeResetSource;
+    image_probe_reset_rc_ = -1;
+    image_probe_set_rc_ = -1;
+    image_probe_descriptor_received_ = false;
+    image_probe_set_returned_ = false;
+}
+
+void KRImageView::ProbeImageEvent(const char *event, int32_t code, float width, float height,
+                                 uint64_t callback_src_hash, uint64_t operation_generation,
+                                 bool from_http_adapter) {
+    if (!image_probe_http_ && !from_http_adapter) return;
+    ImageProbeRecord record;
+    // Only fixed internal event names are accepted; no caller supplies image/user text.
+    if (std::string_view(event) == "complete") record.event = ProbeComplete;
+    else if (std::string_view(event) == "descriptor") record.event = ProbeDescriptor;
+    else if (std::string_view(event) == "reject_source") record.event = ProbeRejectSource;
+    else if (std::string_view(event) == "adapter_error") record.event = ProbeAdapterError;
+    record.instance_hash = ImageProbeHash(GetInstanceId());
+    record.tag = GetViewTag();
+    record.generation = image_probe_generation_;
+    record.operation_generation = operation_generation ? operation_generation : image_probe_generation_;
+    record.src_hash = image_probe_src_hash_;
+    record.current_src_hash = ImageProbeHash(image_src_);
+    record.callback_src_hash = callback_src_hash;
+    record.phase = image_probe_phase_;
+    record.reset_rc = image_probe_reset_rc_;
+    record.set_rc = image_probe_set_rc_;
+    record.descriptor_received = image_probe_descriptor_received_;
+    record.set_returned = image_probe_set_returned_;
+    record.node_present = GetNode() != nullptr;
+    record.callbacks = (load_success_callback_ ? 1 : 0) | (load_resolution_callback_ ? 2 : 0) |
+                       (load_failure_callback_ ? 4 : 0);
+    record.code = code;
+    record.width = width;
+    record.height = height;
+    RecordImageProbe(record);
+}
+
+void KRImageView::SubmitAdapterDescriptor(ArkUI_DrawableDescriptor *descriptor) {
+    const auto generation = image_probe_generation_;
+    const auto source_hash = image_probe_src_hash_;
+    const bool was_http = image_probe_http_;
+    image_probe_phase_ = ProbeDescriptorCall;
+    image_probe_descriptor_received_ = true;
+    image_probe_set_returned_ = false;
+    image_probe_set_rc_ = -1;
+    int32_t result = -1;
+    kuikly::util::SetArkUIImageSrc(GetNode(), descriptor, &result);
+    // A synchronous platform event may change the source. Never overwrite that new probe generation.
+    if (image_probe_generation_ == generation) {
+        image_probe_set_rc_ = result;
+        image_probe_set_returned_ = true;
+        image_probe_phase_ = ProbeDescriptorReturned;
+    }
+    ProbeImageEvent("descriptor", result, 0, 0, source_hash, generation, was_http);
+}
