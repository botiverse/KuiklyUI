@@ -399,8 +399,15 @@ class KuiklyScrollInfo {
         updateContentSizeToRender(reanchorReverse = true)
     }
 
+    private var lastTracedFrameHeight = Float.NaN
+
     internal fun updateContentSizeToRender(reanchorReverse: Boolean) {
         val frame = createContentFrame()
+        val tracedHeight = if (isVertical()) frame.height else frame.width
+        if (tracedHeight != lastTracedFrameHeight) KuiklyScrollTrace.log {
+            lastTracedFrameHeight = tracedHeight
+            "frame current=$currentContentSize height=$tracedHeight reanchor=$reanchorReverse"
+        }
         scrollView?.contentView?.setFrameToRenderView(frame)
         if (reanchorReverse) {
             reanchorReverseNativeOffset()
@@ -609,7 +616,17 @@ class KuiklyScrollInfo {
             viewportSize = viewportSize,
             logicalOffset = composeOffset.toInt()
         )
-        if (shouldDeferReverseReanchor(force, deferWhileScrolling, move.nativeDelta)) return
+        if (shouldDeferReverseReanchor(force, deferWhileScrolling, move.nativeDelta)) {
+            KuiklyScrollTrace.log {
+                "reanchor deferred nativeDelta=${move.nativeDelta} current=$currentContentSize " +
+                    "anchored=$reverseAnchoredContentSize"
+            }
+            return
+        }
+        if (force || move.nativeDelta != 0) KuiklyScrollTrace.log {
+            "reanchor apply force=$force defer=$deferWhileScrolling nativeDelta=${move.nativeDelta} " +
+                "target=${move.nativeOffset} current=$currentContentSize anchored=$reverseAnchoredContentSize"
+        }
         reverseAnchoredContentSize = currentContentSize
         if (move.nativeDelta == 0 && !force) return
         val issueMove = needsNativeMove(move.nativeOffset)
