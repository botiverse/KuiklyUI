+
+package com.tencent.kuikly.compose.gestures
+
+/**
+ * Diagnostics-only trace of the scroll / content-size pipeline (botiverse/mobile task #37).
+ * The host installs [sink] for diagnostic builds; while it is null every call site costs one
+ * null check and builds no strings.
+ */
+object KuiklyScrollTrace {
+    var sink: ((String) -> Unit)? = null
+
+    inline fun log(message: () -> String) {
+        val s = sink ?: return
+        s(message())
+    }
+}
