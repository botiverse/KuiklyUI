+package com.tencent.kuikly.core.render.android.expand.component
+
+import android.text.Spanned
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Test
+
+class TextFieldLineHeightSpanPolicyTest {
+
+    @Test
+    fun emptyEditorSpanIncludesFirstInsertion() {
+        assertEquals(Spanned.SPAN_MARK_POINT, TEXT_FIELD_LINE_HEIGHT_SPAN_FLAGS)
+        assertNotEquals(Spanned.SPAN_POINT_POINT, TEXT_FIELD_LINE_HEIGHT_SPAN_FLAGS)
